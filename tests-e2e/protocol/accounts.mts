import { readFileSync } from "node:fs";
import * as P from "/home/joshua/rust/audio/front/src/lib/protocol.ts";
const log = process.argv[2];
const ok = (c: any, m: string) => { if (!c) { console.log("ÉCHEC", m); process.exit(1); } console.log("ok", m); };
async function conn() {
  const ws = new WebSocket("wss://127.0.0.1:8444"); await new Promise((r) => (ws.onopen = r));
  return new P.ProtocolClient(ws as any);
}
const bootInvite = /\/\?invite=(\S+)/.exec(readFileSync(log, "utf8"))![1];
ok(bootInvite, "au démarrage : invitation pour le compte admin affichée");
let c = await conn();
ok((await c.request(P.requestMagicLink("x@y.fr"))).error?.code === 403, "demander soi-même un lien : refusé");
let r = await c.request(P.acceptInvite(bootInvite, "admin@x.fr", "Léa", "motdepasse-admin"));
const admin = r.authResponse!;
ok(admin.me!.isAdmin && admin.me!.hasPassword && admin.me!.pseudo === "Léa", "invitation du bootstrap : compte admin créé, connecté, pseudo choisi");
const inv = (await c.request(P.createInvite(3600))).inviteCreated!.invite!;
ok(Number(inv.expiresAt) - Number(inv.createdAt) === 3_600_000, "invitation créée, 1 h");
const checked = (await (await conn()).request(P.checkInvite(inv.token))).inviteChecked;
ok(checked && Number(checked.expiresAt) === Number(inv.expiresAt), "invitation vérifiée à l'ouverture, sans compte : valable, échéance");
ok((await (await conn()).request(P.checkInvite("00000000-0000-4000-8000-000000000000"))).error?.code === 404, "invitation inconnue : 404");
ok((await c.request(P.listInvites())).invites!.invites.length === 1, "liste des invitations en cours");
ok((await c.request(P.createInvite(10))).error?.code === 400, "durée < 1 min refusée");
const b = await conn();
ok((await b.request(P.acceptInvite(inv.token, "bob@x.fr", "Bob", "court"))).error?.code === 400, "mot de passe trop court");
ok((await b.request(P.acceptInvite(inv.token, "admin@x.fr", "Bob", "motdepasse-bob"))).error?.code === 409, "email déjà utilisé");
ok((await b.request(P.acceptInvite(inv.token, "bob@x.fr", "léa", "motdepasse-bob"))).error?.code === 409, "pseudo déjà pris");
r = await b.request(P.acceptInvite(inv.token, "Bob@X.fr", "Bob", "motdepasse-bob"));
const bob = r.authResponse!; ok(bob && !bob.me!.isAdmin && bob.me!.email === "bob@x.fr", "Bob crée son compte (email normalisé)");
ok((await (await conn()).request(P.acceptInvite(inv.token, "eve@x.fr", "Eve", "motdepasse-eve"))).error?.code === 404, "invitation déjà utilisée : refusée");
ok((await (await conn()).request(P.checkInvite(inv.token))).error?.code === 404, "invitation déjà utilisée : vérification 404");
ok((await b.request(P.createInvite(3600))).error?.code === 403, "Bob (non admin) ne crée pas d'invitation");
const bobId = Number(bob.me!.id);
r = await (await conn()).request(P.passwordLogin("bob@x.fr", "motdepasse-bob"));
ok(r.authResponse && Number(r.authResponse.me!.id) === bobId, "connexion email + mot de passe");
const wrong = (await (await conn()).request(P.passwordLogin("bob@x.fr", "faux-mot-de-passe"))).error!;
const unknown = (await (await conn()).request(P.passwordLogin("personne@x.fr", "faux-mot-de-passe"))).error!;
ok(wrong.code === 401 && unknown.code === 401 && wrong.message === unknown.message, "mauvais mot de passe et email inconnu : même erreur");
const e = await conn();
for (let i = 0; i < 9; i++) await e.request(P.passwordLogin("bob@x.fr", "faux"));
ok((await e.request(P.passwordLogin("bob@x.fr", "motdepasse-bob"))).error?.code === 429, "10 échecs : email bloqué, même avec le bon mot de passe");
const link = (await c.request(P.createLoginLink(bobId, 600))).loginLinkCreated!;
const viaLink = await (await conn()).request(P.authRequest(link.token));
ok(viaLink.authResponse && Number(viaLink.authResponse.me!.id) === bobId, "lien de connexion créé par l'admin : Bob connecté (dépannage)");
ok((await (await conn()).request(P.authRequest(link.token))).error?.code === 401, "lien de connexion : usage unique");
ok((await b.request(P.createLoginLink(bobId, 600))).error?.code === 403, "lien de connexion : admin seul");
ok((await b.request(P.setPassword("pas-le-bon", "nouveau-mdp-bob"))).error?.code === 401, "changer de mot de passe : l'actuel est vérifié");
ok((await b.request(P.setPassword("motdepasse-bob", "nouveau-mdp-bob"))).passwordSet, "mot de passe changé");
const inv2 = (await c.request(P.createInvite(3600))).inviteCreated!.invite!;
ok((await c.request(P.revokeInvite(inv2.token))).inviteRevoked && (await c.request(P.listInvites())).invites!.invites.length === 0, "invitation révoquée");
ok((await (await conn()).request(P.checkInvite(inv2.token))).error?.code === 404, "invitation révoquée : vérification 404 (pas de formulaire)");
const d = await conn(); const dev = (await d.request(P.authRequest("00000000-0000-0000-0000-000000000002"))).authResponse!;
ok(!dev.me!.hasPassword && (await d.request(P.setPassword("", "premier-mdp-dev"))).passwordSet, "compte sans mot de passe : en définit un sans l'actuel");
process.exit(0);
