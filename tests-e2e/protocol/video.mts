import * as P from "/home/joshua/rust/audio/front/src/lib/protocol.ts";
import { chat } from "/home/joshua/rust/audio/front/src/proto/messages.js";
const BASE = "https://127.0.0.1:8444";
const ok = (c: any, m: string) => { if (!c) { console.log("ÉCHEC", m); process.exit(1); } console.log("ok", m); };
const ws = new WebSocket("wss://127.0.0.1:8444"); await new Promise((r) => (ws.onopen = r));
const c = new P.ProtocolClient(ws as any);
const token = (await c.request(P.authRequest("00000000-0000-0000-0000-000000000001"))).authResponse!.sessionToken!;
await c.request(P.setPseudo("Léa"));
const video = new Uint8Array(5_000_000).map((_, i) => (i * 13) % 256);
video.set([0, 0, 0, 0x20, ...new TextEncoder().encode("ftypisom"), 0, 0, 2, 0]);
const up = await fetch(BASE + "/media", { method: "POST", headers: { Authorization: `Bearer ${token}`, "X-Media-Name": "clip.mp4" }, body: video });
const m = chat.MediaUploaded.decode(new Uint8Array(await up.arrayBuffer())).media!;
ok(m.mime === "video/mp4" && m.name === "clip.mp4", "MP4 reconnu comme vidéo");
const mov = new Uint8Array(100); mov.set([0, 0, 0, 0x14, ...new TextEncoder().encode("ftypqt  ")]);
const r2 = await fetch(BASE + "/media", { method: "POST", headers: { Authorization: `Bearer ${token}` }, body: mov });
ok(chat.MediaUploaded.decode(new Uint8Array(await r2.arrayBuffer())).media!.mime === "video/quicktime", "MOV reconnu");
const t = (await c.request(P.requestDownload(m.id, true))).downloadTicket!.ticket;
const url = `${BASE}/media/${m.id}?ticket=${t}`;
let r = await fetch(url, { headers: { Range: "bytes=0-1023" } });
let b = new Uint8Array(await r.arrayBuffer());
ok(r.status === 206 && r.headers.get("content-range") === `bytes 0-1023/${video.length}` && b.length === 1024 && b[500] === video[500], "plage 0-1023 : 206, Content-Range, octets exacts");
ok(r.headers.get("content-type") === "video/mp4" && !r.headers.get("content-disposition") && r.headers.get("accept-ranges") === "bytes", "ticket de lecture : servi en ligne, Accept-Ranges");
r = await fetch(url, { headers: { Range: "bytes=4999000-" } }); b = new Uint8Array(await r.arrayBuffer());
ok(r.status === 206 && b.length === 1000 && b[999] === video[4999999], "plage ouverte jusqu'à la fin (déplacement dans la vidéo)");
r = await fetch(url, { headers: { Range: "bytes=-10" } }); b = new Uint8Array(await r.arrayBuffer());
ok(r.status === 206 && b.length === 10 && b[0] === video[4999990], "10 derniers octets (index MP4 en fin de fichier)");
r = await fetch(url, { headers: { Range: "bytes=6000000-" } });
ok(r.status === 416 && r.headers.get("content-range") === `bytes */${video.length}`, "plage hors fichier : 416");
r = await fetch(url); b = new Uint8Array(await r.arrayBuffer());
ok(r.status === 200 && b.length === video.length, "sans plage : fichier entier");
const d = (await c.request(P.requestDownload(m.id))).downloadTicket!.ticket;
r = await fetch(`${BASE}/media/${m.id}?ticket=${d}`, { headers: { Range: "bytes=100-199" } });
ok(r.status === 206 && r.headers.get("content-disposition")?.startsWith("attachment"), "ticket de téléchargement : pièce jointe, plages aussi (reprise)");
const doc = await fetch(BASE + "/media", { method: "POST", headers: { Authorization: `Bearer ${token}` }, body: new TextEncoder().encode("<html>") });
const docId = chat.MediaUploaded.decode(new Uint8Array(await doc.arrayBuffer())).media!.id;
const st = (await c.request(P.requestDownload(docId, true))).downloadTicket!.ticket;
r = await fetch(`${BASE}/media/${docId}?ticket=${st}`);
ok(r.headers.get("content-type") === "application/octet-stream" && r.headers.get("content-disposition")?.startsWith("attachment"), "fichier quelconque par ticket de lecture : reste en pièce jointe");
process.exit(0);
